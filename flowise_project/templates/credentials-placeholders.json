{
  "providers": {
    "openai": {
      "enabled_env": "OPENAI_API_KEY",
      "models": [
        "gpt-4.1",
        "gpt-4.1-mini",
        "gpt-4o",
        "gpt-4o-mini"
      ],
      "credential_note": "Do not store real key in exported JSON."
    },
    "deepseek": {
      "enabled_env": "DEEPSEEK_API_KEY",
      "base_url_env": "DEEPSEEK_BASE_URL",
      "models": [
        "deepseek-chat",
        "deepseek-reasoner"
      ],
      "credential_note": "Use OpenAI-compatible API mode if Flowise node supports custom base URL."
    },
    "ollama_mistral": {
      "enabled_env": "OLLAMA_BASE_URL",
      "base_url_default": "http://localhost:11434",
      "models": [
        "mistral",
        "mistral:7b-instruct",
        "mistral-small"
      ],
      "credential_note": "Local model mode must use only Mistral via Ollama."
    }
  }
}
