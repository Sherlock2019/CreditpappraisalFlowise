DATABASE_URL=postgresql+psycopg2://credit_ai_user:credit_ai_password@postgres:5432/credit_ai
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai

# Custom Public OpenAI-compatible API
CUSTOM_PUBLIC_API_BASE_URL=
CUSTOM_PUBLIC_API_KEY=
CUSTOM_PUBLIC_API_MODEL=

# Mistral API example:
# CUSTOM_PUBLIC_API_BASE_URL=https://api.mistral.ai/v1
# CUSTOM_PUBLIC_API_MODEL=mistral-small-latest

# Together AI example:
# CUSTOM_PUBLIC_API_BASE_URL=https://api.together.xyz/v1
