# OpenRouter example:
# CUSTOM_PUBLIC_API_BASE_URL=https://openrouter.ai/api/v1
# CUSTOM_PUBLIC_API_MODEL=mistralai/mistral-small-3.1-24b-instruct

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:7b-instruct
OLLAMA_LOCAL_MODEL=mistral
DEV_ALLOW_INSECURE_CUSTOM_API=false

FLOWISE_BASE_URL=
FLOWISE_API_URL=http://flowise:3000
FLOWISE_API_KEY=
FLOWISE_CHATFLOW_ID=
POC_BACKEND_BASE_URL=http://localhost:8000
BACKEND_URL=http://backend:8000

# Retail banking workflow defaults
DEFAULT_BASE_INTEREST_RATE_PCT=8.5
DEFAULT_LOAN_TERM_MONTHS=60
AUDIT_LOG_DIR=/app/data/audit_logs
WORKFLOW_STATE_DIR=/app/data/workflow_state
EMAIL_DRAFT_DIR=/app/data/email_drafts
DEMO_CUSTOMER_DOCUMENTS_DIR=/app/demo/customer_documents

# S3 / S3-compatible storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=
